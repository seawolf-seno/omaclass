{
  "schemaVersion": 1,
  "id": "omaclass",
  "name": "OmaClass",
  "version": "0.1.0",
  "author": "Pacifica Christian High School",
  "license": "MIT",
  "description": "Classroom management in the Omarchy bar: see who's online, lock screens, message the class, open a website, and jump to the full Veyon classroom view.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "OmaClass",
    "description": "Teacher controls for the classroom, through Veyon.",
    "category": "Education",
    "aliases": [
      "classroom",
      "veyon",
      "teacher"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "sampleClass": false,
      "refreshIntervalSec": 10
    },
    "schema": [
      {
        "key": "sampleClass",
        "type": "boolean",
        "label": "Show a sample class (for demos)",
        "defaultValue": false
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval while open (seconds)",
        "min": 5,
        "max": 300,
        "step": 5,
        "defaultValue": 10
      }
    ]
  }
}
